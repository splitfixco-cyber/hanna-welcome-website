# Copy to .env.local for local scripts. On Vercel, set these under Project > Settings > Environment Variables.
# Never commit .env.local.

# Stripe restricted key with READ access to Checkout Sessions and Payment Links (Developers > API keys > Restricted keys)
STRIPE_SECRET_KEY=rk_live_...
# From the webhook endpoint in Stripe (Developers > Webhooks > the endpoint > Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_...

# Vercel Blob store token (Storage > the blob store > .env.local tab)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Outgoing email. Gmail: host smtp.gmail.com, port 465, user = the Gmail address, pass = an App Password.
# Resend: host smtp.resend.com, port 465, user = resend, pass = the API key, MAIL_FROM on a verified domain.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM="Hanna's Universe <you@gmail.com>"
MAIL_REPLY_TO=you@gmail.com

# Public URL of the site, used in download links
SITE_URL=https://www.hannasuniverse.com
