{
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/test",
      "destination": "/test-es.html",
      "permanent": false
    },
    {
      "source": "/quiz",
      "destination": "/test.html",
      "permanent": false
    },
    {
      "source": "/teste",
      "destination": "/test-pt.html",
      "permanent": false
    },
    {
      "source": "/colorear",
      "destination": "/colorear-es.html",
      "permanent": false
    },
    {
      "source": "/monarca",
      "destination": "/colorear-es.html#monarca",
      "permanent": false
    },
    {
      "source": "/luciernagas",
      "destination": "/colorear-es.html#luciernagas",
      "permanent": false
    },
    {
      "source": "/numeros",
      "destination": "/colorear-es.html#numeros",
      "permanent": false
    },
    {
      "source": "/tarjetas",
      "destination": "/tarjetas-es.html",
      "permanent": false
    },
    {
      "source": "/cards",
      "destination": "/cards.html",
      "permanent": false
    },
    {
      "source": "/assets/books/trilingual-vol1.png",
      "destination": "/assets/books/trilingual-vol1.jpg",
      "permanent": true
    },
    {
      "source": "/assets/books/trilingual-vol2.png",
      "destination": "/assets/books/trilingual-vol2.jpg",
      "permanent": true
    },
    {
      "source": "/assets/books/coloring-book.png",
      "destination": "/assets/books/coloring-book.jpg",
      "permanent": true
    },
    {
      "source": "/assets/books/promises-of-god.png",
      "destination": "/assets/books/promises-of-god.jpg",
      "permanent": true
    },
    {
      "source": "/assets/books/21-day-devotional.png",
      "destination": "/assets/books/21-day-devotional.jpg",
      "permanent": true
    },
    {
      "source": "/assets/hero-welcome.png",
      "destination": "/assets/hero-welcome.jpg",
      "permanent": true
    }
  ]
}
